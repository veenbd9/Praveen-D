# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# --- Google Gemini (AI resume analysis) ---
GEMINI_API_KEY=

# --- Supabase (client-side; anon key is safe to expose, protected by RLS) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# --- Google Places (server-side only; used by api/google-reviews.ts) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Job search (Adzuna; server-side only) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# The following are server-side secrets used by the Vercel serverless functions
# in /api. Set them in the Vercel Project Settings -> Environment Variables,
# NOT in this file (this file is only loaded by Vite for the frontend build).
#
# SUPABASE_SERVICE_ROLE_KEY=   (Supabase -> Project Settings -> API -> service_role)
# STRIPE_SECRET_KEY=           (Stripe -> Developers -> API keys)
# STRIPE_WEBHOOK_SECRET=       (Stripe -> Developers -> Webhooks -> signing secret)
# RAZORPAY_KEY_ID=             (Razorpay -> Settings -> API Keys)
# RAZORPAY_KEY_SECRET=
# BREVO_API_KEY=               (Brevo -> SMTP & API -> API Keys)
# BREVO_SENDER_EMAIL=          (a verified sender in Brevo, e.g. noreply@scaleupresume.com)
# PUBLIC_SITE_URL=             (e.g. https://scaleupresume.com)
# MSG91_AUTH_KEY=              (MSG91 -> Settings -> API -> Authkey)
# MSG91_OTP_TEMPLATE_ID=       (MSG91 -> OTP -> Templates; needs DLT approval for India)
# APIFY_API_TOKEN=             (Apify -> Settings -> Integrations -> API token; powers the Jobs tab's LinkedIn search)
# SITE_LAUNCHED=               (false/unset shows the "Coming Soon" page publicly; set to true on launch day)
# PREVIEW_ACCESS_CODE=         (secret to bypass Coming Soon before launch, e.g. https://scaleupresume.com/?access=<code>)
# GOOGLE_OAUTH_CLIENT_ID=      (Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID)
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=   (must exactly match an "Authorized redirect URI" on that OAuth client, e.g. https://scaleupresume.com/api/gmail-oauth-callback)
#   Used by the Jobs tab's "Connect Gmail" flow: users authorize ScaleupResume
#   (scope gmail.send) so Auto Apply emails a hiring manager from the user's
#   own Gmail account instead of ours. Requires enabling the Gmail API and
#   configuring the OAuth consent screen in Google Cloud Console — see README.
